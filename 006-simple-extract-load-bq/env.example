# Standardowe zmienne dla oficjalnego docker-compose Apache Airflow (quickstart).
# Skopiuj do .env i dostosuj lokalnie: cp env.example .env

# UID użytkownika hosta, na którym mają działać kontenery (Linux/macOS: `id -u`)
AIRFLOW_UID=50000

# Dane logowania do UI Airflow tworzone przy pierwszym starcie
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Connection "bigquery" i Variable "gcp_project_id" trzeba dodać ręcznie
# w UI Airflow (Admin > Connections / Admin > Variables) - DAG ich oczekuje.
